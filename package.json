{
  "name": "astrolabe",
  "productName": "Astrolabe",
  "version": "0.1.0",
  "private": true,
  "description": "A block-based terminal with a built-in code editor",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "build:main": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --format=cjs --outdir=dist-electron --out-extension:.js=.cjs --external:electron --external:node-pty --sourcemap",
    "build:ui": "vite build",
    "build": "npm run build:main && npm run build:ui && node scripts/stamp.mjs",
    "typecheck": "tsc --noEmit",
    "start": "electron .",
    "dev": "npm run build:main && (vite & sleep 2 && ASTROLABE_DEV_URL=http://localhost:5173 electron .)",
    "package": "npm run build && electron-packager . Astrolabe --platform=darwin --arch=arm64 --out=release --overwrite --no-asar --icon=build/icon.icns --app-bundle-id=dev.astrolabe.app --ignore='^/(src|electron|release|test|scripts|build|\\.gitignore|tsconfig.*|vite\\.config\\.ts|index\\.html|README\\.md)' --prune=true",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/darwin-*/spawn-helper 2>/dev/null || true",
    "test:drive": "npm run build && node test/drive.mjs",
    "icon": "python3 scripts/icon_svg.py && node scripts/make-icon.mjs",
    "install-app": "npm run package && rm -rf /Applications/Astrolabe.app && ditto release/Astrolabe-darwin-arm64/Astrolabe.app /Applications/Astrolabe.app && rm -rf release"
  },
  "dependencies": {
    "@fontsource/cutive-mono": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource/commit-mono": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@milkdown/kit": "^7.23.0",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.17",
    "electron": "^45.3.0",
    "esbuild": "^0.28.2",
    "gemoji": "^8.1.0",
    "marked": "^18.2.0",
    "monaco-editor": "^0.57.0",
    "playwright-core": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "zustand": "^5.1.0"
  }
}
